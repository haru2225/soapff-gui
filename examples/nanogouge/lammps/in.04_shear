# 04: steady shear at constant normal stress (Lin & Hatano 2024 conditions: sigma_n 5.6 / 56 MPa, rate ~1e8 /s)
#   box tilt xz grows at rate*lz (fix deform, remap v: Lees-Edwards boundaries); z is kept at the normal stress; x and y stay fixed.
#   gamma = rate * dt * step (the box flips back when the tilt gets large, so xz/lz is not the strain).  Slip velocity across the box V = rate * Lz.
#   flow 1 (default; Lin's thesis, Osaka 2024, sect. 2.2): the cell deformation alone drives the shear (Lees-Edwards boundaries, a velocity
#           ramp at the start), Langevin thermostat on the velocity relative to the linear profile (temp/deform), Nose-Hoover barostat on z only
#           (fix nph z; x and y fixed).  No wall: shear bands form where they want.  Works with any LAMMPS version.
#   flow 2: as 1, but the Langevin thermostat acts on vy only (perpendicular to the flow): it does not pull a localized profile back to the
#           linear one (check of the thermostat effect; Zhou et al. 2023 discuss the same question).
#   flow 3: as 1 without thermostat: the frictional heat stays.
#   flow 0: SLLOD + Nose-Hoover on every atom (imposed homogeneous flow) + fix press/langevin on z (LAMMPS 21Nov2023 or newer; -var pl 0: no barostat).
#   Phases: 0 = the shear at "rate" up to gmax (its end: shear_<s>_final.data, the start of 05), then nvs velocity steps, each vstep_dg of strain at
#           rate * vfac^k (default 4 steps of x3.16: 1e8 -> 3.2e8, 1e9, 3.2e9, 1e10 /s; ~8 % more time): shear stress against slip velocity from one run
#           (Zhou et al. 2023, Fig. 8, 10).  -var nvs 0: no velocity steps.
#   All-atom snapshots (the water too, for fig9 of hot_spots.py): shear_<s>_all_<step>.dump at the start and at the end of each phase.
#   Outputs for analysis/hot_spots.py (one file per job and phase, named by its first step):
#     particles_<s>.<step>.dat  every part_dg of strain: centre of mass (unwrapped), its velocity, gyration tensor (-> normal, size) and internal temperature of each particle
#     prof_<s>.<step>.dat       averaged over prof_dg of strain, nz layers across the gouge: vx of water and of clay, their numbers, temperature of the layer
#   lmp -in in.04_shear -var data 03_consolidate_5.6.data -var settings gouge.settings -var sigma 5.6 -var rate 1.0e-7 -var gmax 3.0
#   continued by the next job (job.sh):  -var resume 1 -var rfile shear_5.6.restart.stop -var sigma 5.6
include in.init
variable sigma index 5.6            # MPa
variable rate index 1.0e-7          # engineering shear rate in 1/fs (1.0e-7 = 1e8 /s)
variable gmax index 3.0             # final shear strain of phase 0
variable nvs index 4                # velocity steps after phase 0 (0 = none)
variable vfac index 3.16227766      # rate factor from one velocity step to the next
variable vstep_dg index 0.5         # strain of each velocity step
variable flow index 1               # 1 Lin (Langevin on the deviation from the linear profile), 2 Langevin on vy, 3 no thermostat, 0 SLLOD
variable Tdamp index 1000.0         # fs: Langevin damping time (flow 1, 2)
variable pl index 1                 # flow 0 only: 1 = fix press/langevin, 0 = no barostat (constant Lz; job.sh sets it for an older LAMMPS)
variable part_dg index 0.002        # strain between two lines of particles_<s>.*.dat
variable prof_dg index 0.05         # strain over which a velocity profile is averaged
variable nz index 40                # layers of the velocity profile
variable dump_dg index 0.01         # strain between two frames of shear_<s>.dump; 0 = none
variable Pn equal ${sigma}*9.86923

variable Pdamp index 10000.0        # fs
variable rest_every index 10000     # a restart every this many steps (besides the one written at the time limit)
if "${nrun} > 0" then "variable dump_every index ${nout}"   # test: 10 frames per run
variable dump_every index $(round(v_dump_dg/(v_rate*v_dt)))   # steps between trajectory frames in phase 0 (-var dump_every N sets it directly); x5 in strain in the velocity steps
log log.04_shear_${sigma} append
if "${resume} == 0" then "change_box all triclinic" "kspace_style pppm ${acc}"
thermo 1000
compute tdef all temp/deform
thermo_modify temp tdef             # thermo "temp" = temperature without the mean shear flow
compute ty all temp/partial 0 1 0
if "${flow} == 0" then "fix fs all nvt/sllod temp ${T} ${T} 100.0" "fix_modify fs temp tdef"
if "${flow} == 0 && ${pl} == 1" then "fix fp all press/langevin z ${Pn} ${Pn} ${Pdamp} temp ${T} ${T} ${seed} dilate all"
# flow 1-3: Nose-Hoover barostat on z (integrates the motion too), Langevin thermostat on the velocity without the shear flow
if "${flow} > 0" then "fix fs all nph z ${Pn} ${Pn} ${Pdamp} dilate all ptemp ${T}" "fix_modify fs temp tdef"
if "${flow} == 1" then "fix fl all langevin ${T} ${T} ${Tdamp} ${seed}" "fix_modify fl temp tdef"
if "${flow} == 2" then "fix fl all langevin ${T} ${T} ${Tdamp} ${seed}" "fix_modify fl temp ty"
compute pt all pressure tdef
# phase bookkeeping (from the step alone, so a job that continues from a restart knows where it is): phase kk runs from step Sb to Se at rate rk,
# strain from Gb to Ge.  gam = nominal strain (the box flips back when the tilt gets large, so xz/lz is not the strain)
variable kk equal 0
variable Sb equal 0
variable Gb equal 0.0
variable rk equal ${rate}
variable rprev equal 0.0
variable ran equal 0
variable gam equal v_Gb+v_rk*v_dt*(step-v_Sb)
variable ss equal -c_pt[5]*0.101325     # shear stress (MPa)
variable sn equal c_pt[3]*0.101325      # normal stress (MPa, compression > 0)
variable mu equal v_ss/v_sn
variable dens equal mass(clay)*1.66054/vol
variable lzv equal lz
variable lxv equal lx
variable lyv equal ly
# 1000-step averages (a job that continues a run loses at most 2000 steps of them); written by fix print (append) so that the file grows across jobs
variable avf equal $(10*ceil(v_nout/10))
if "${nrun} == 0" then "variable avf equal 1000"
fix av all ave/time $(v_avf/10) 10 ${avf} v_gam v_ss v_sn v_mu v_lzv v_dens c_tdef v_lxv v_lyv
if "${resume} == 0" then "print '# TimeStep gamma tau(MPa) sigma_n(MPa) mu Lz(A) rho_b(g/cm3) T(K) Lx(A) Ly(A) rate(1/s)' file shear_${sigma}.dat"
# first line one whole averaging window after the (re)start, then every 1000 steps
variable nextpr equal (floor((step+v_avf-1)/v_avf)+1)*v_avf
fix pr all print v_nextpr "$(step) $(f_av[1]:%.6g) $(f_av[2]:%.6g) $(f_av[3]:%.6g) $(f_av[4]:%.6g) $(f_av[5]:%.6g) $(f_av[6]:%.6g) $(f_av[7]:%.5g) $(f_av[8]:%.6g) $(f_av[9]:%.6g) $(v_rk*1e15:%.5g)" append shear_${sigma}.dat screen no
# particles (clay without Na: the Na ions move on their own): centre of mass, velocity, shape, internal temperature
variable isna atom abs(mass-22.98977)<0.01
group na variable isna
group part subtract clay na
compute cpart part chunk/atom molecule nchunk once ids once compress yes
compute pcom part com/chunk cpart
compute pvcm part vcm/chunk cpart
compute pgyr part gyration/chunk cpart tensor
compute ptmp part temp/chunk cpart temp com yes
# velocity and temperature profile across the gouge (layers in z, reduced units of the tilted box)
compute czw water chunk/atom bin/1d z lower $(1.000001/v_nz) units reduced
compute czc part chunk/atom bin/1d z lower $(1.000001/v_nz) units reduced
compute cza all chunk/atom bin/1d z lower $(1.000001/v_nz) units reduced
compute zpw water property/chunk czw count coord1
compute zpc part property/chunk czc count
compute zvw water vcm/chunk czw
compute zvc part vcm/chunk czc
compute zta all temp/chunk cza temp com yes
restart ${rest_every} shear_${sigma}.restart.1 shear_${sigma}.restart.2
if "${dump_every} > 0" then "dump dm ${dump_group} custom ${dump_every} shear_${sigma}.dump id mol type xu yu zu" "dump_modify dm append yes"
# a run started with this input (job.sh / submit_chain.sh: a shear without this file was started with an older input and is redone)
if "${resume} == 0" then "print 'in.04_shear with phases (velocity steps) and particle outputs' file shear_${sigma}.v2" "write_dump all custom shear_${sigma}_all_0.dump id mol type xu yu zu"

# ---------------- phases: 0 = rate up to gmax; 1..nvs = velocity steps ----------------
label phase
variable rk equal $(v_rate*v_vfac^v_kk)
if "${kk} == 0" then "variable dgk equal ${gmax}" else "variable dgk equal ${vstep_dg}"
variable Se equal $(v_Sb+round(v_dgk/(v_rk*v_dt)))
variable Ge equal $(v_Gb+v_dgk)
if "${nrun} > 0" then "variable Se equal $(v_Sb+v_nrun)" "variable Ge equal $(v_Gb+v_nrun*v_rk*v_dt)"
if "$(step) >= ${Se}" then "variable ran equal 0" "jump SELF phase_end"
print "04: phase ${kk}: rate $(v_rk*1e15:%.4g) /s, strain ${Gb} -> ${Ge}, steps ${Sb} -> ${Se} (now $(step))"
# the shear: the box tilt grows at rk*Lz; a new rate also adds its change of the flow profile to the velocities (once: when the phase before ended in this job,
# or at the very start)
fix fd all deform 1 xz erate ${rk} remap v units box
if "${flow} > 0 && ((${kk} == 0 && ${resume} == 0 && $(step) == 0) || (${kk} > 0 && ${ran} == 1))" then "velocity all ramp vx 0.0 $((v_rk-v_rprev)*lz) z $(zlo) $(zhi) sum yes units box"
# outputs every so much strain (steps at this rate): particles, profiles; the trajectory 5 x less often in the velocity steps
variable npart equal $((round(v_part_dg/(v_rk*v_dt))+(round(v_part_dg/(v_rk*v_dt))<1)))
variable nrep equal $((round(v_prof_dg/(v_rk*v_dt)/100)+(round(v_prof_dg/(v_rk*v_dt)/100)<1)))
if "${nrun} > 0" then "variable npart equal ${nout}" "variable nrep equal 1"
fix fpart part ave/time ${npart} 1 ${npart} c_pcom[1] c_pcom[2] c_pcom[3] c_pvcm[1] c_pvcm[2] c_pvcm[3] c_pgyr[1] c_pgyr[2] c_pgyr[3] c_pgyr[4] c_pgyr[5] c_pgyr[6] c_ptmp[1] mode vector file particles_${sigma}.$(step).dat
fix fprof all ave/time 100 ${nrep} $(100*v_nrep) c_zpw[2] c_zpw[1] c_zvw[1] c_zpc c_zvc[1] c_zta[1] mode vector file prof_${sigma}.$(step).dat
if "${dump_every} > 0 && ${kk} > 0 && ${nrun} == 0" then "dump_modify dm every $((round(5*v_dump_dg/(v_rk*v_dt))+(round(5*v_dump_dg/(v_rk*v_dt))<1)))"
run ${Se} upto
if "$(step) < ${Se}" then "write_restart shear_${sigma}.restart.stop" "write_data shear_${sigma}.latest.data nocoeff" "quit 0"
variable ran equal 1
# the end of the phase (in this job): all atoms with the water; the end of phase 0 is the start of the healing (05)
write_dump all custom shear_${sigma}_all_$(step).dump id mol type xu yu zu
if "${kk} == 0" then "write_data shear_${sigma}_final.data"
label phase_end
variable Sb equal ${Se}
variable Gb equal ${Ge}
variable rprev equal ${rk}
variable kk equal $(v_kk+1)
if "${kk} <= ${nvs}" then "jump SELF phase"
print "DONE 04" file shear_${sigma}.done
