# 05: stop the shear and hold (static contact time): the shear stress relaxes and the layers re-stack.
#   lmp -in in.05_heal -var data shear_5.6_final.data -var settings gouge.settings -var sigma 5.6 -var t_ps 5000
#   continued by the next job (job.sh):  -var resume 1 -var rfile heal_5.6.restart.stop -var sigma 5.6
include in.init
variable sigma index 5.6
variable t_ps index 5000
variable rest_every index 10000
variable Pn equal ${sigma}*9.86923
log log.05_heal_${sigma} append
thermo 1000
compute pt all pressure thermo_temp
variable ss equal -c_pt[5]*0.101325
variable sn equal -c_pt[3]*0.101325
variable dens equal mass(clay)*1.66054/vol
variable lzv equal lz
variable nst equal round(v_t_ps*1000/v_dt)
fix fnpt all npt temp ${T} ${T} 100.0 z ${Pn} ${Pn} 1000.0
fix av all ave/time 100 10 1000 v_ss v_sn v_lzv v_dens
if "${resume} == 0" then "print '# TimeStep v_ss v_sn v_lzv v_dens' file heal_${sigma}.dat"
# first line one whole averaging window after the (re)start, then every 1000 steps
variable nextpr equal (floor((step+999)/1000)+1)*1000
fix pr all print v_nextpr "$(step) $(f_av[1]:%.6g) $(f_av[2]:%.6g) $(f_av[3]:%.6g) $(f_av[4]:%.6g)" append heal_${sigma}.dat screen no
restart ${rest_every} heal_${sigma}.restart.1 heal_${sigma}.restart.2
run ${nst} upto
if "$(step) < ${nst}" then "write_restart heal_${sigma}.restart.stop" "write_data heal_${sigma}.latest.data nocoeff" "quit 0"
write_data heal_${sigma}_final.data
print "DONE 05" file heal_${sigma}.done
