# 03: hold the dehydrated assemblage at the normal stress sigma (z only; x and y stay fixed)
#   lmp -in in.03_consolidate -var data 02_dehydrate.data -var settings gouge.settings -var sigma 5.6
#   continued by the next job (job.sh):  -var resume 1 -var rfile 03_consolidate_5.6.restart.stop -var sigma 5.6
include in.init
variable sigma index 5.6            # normal stress, MPa
variable t_ps index 2000
variable rest_every index 10000
variable Pn equal ${sigma}*9.86923  # atm  (1 MPa = 9.86923 atm)
log log.03_consolidate_${sigma} append
thermo 1000
variable lzv equal lz
variable dens equal mass(clay)*1.66054/vol
variable nst equal round(v_t_ps*1000/v_dt)
fix fnpt all npt temp ${T} ${T} 100.0 z ${Pn} ${Pn} 1000.0
fix av all ave/time 100 10 1000 v_lzv v_dens
if "${resume} == 0" then "print '# TimeStep v_lzv v_dens' file 03_consolidate_${sigma}.dat"
# first line one whole averaging window after the (re)start, then every 1000 steps
variable nextpr equal (floor((step+999)/1000)+1)*1000
fix pr all print v_nextpr "$(step) $(f_av[1]:%.6g) $(f_av[2]:%.6g)" append 03_consolidate_${sigma}.dat screen no
restart ${rest_every} 03_consolidate_${sigma}.restart.1 03_consolidate_${sigma}.restart.2
run ${nst} upto
if "$(step) < ${nst}" then "write_restart 03_consolidate_${sigma}.restart.stop" "write_data 03_consolidate_${sigma}.latest.data nocoeff" "quit 0"
write_data 03_consolidate_${sigma}.data
print "DONE 03" file 03_consolidate_${sigma}.done
