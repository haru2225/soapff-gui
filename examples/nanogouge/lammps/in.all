# in.all: the whole calculation in one input file (production lengths below; -var nrun N: a test, every run N steps):
#   01 minimisation (miniter), NVT neq, NPzT neq at 1 atm                                -> 01_equil.data
#   02 ndry water removals (down to m_w/m_c = final_mwmc), NPzT ndwell after each           -> 02_dehydrate.data, dehydrate.dat
#   then for the normal stress sig1, then sig2 (MPa; sig2 0 = only sig1):
#   03 NPzT at sigma in pieces of ncons until Lz changes by less than constol over a piece (at most nconsmax pieces) -> 03_consolidate_<s>.data/.dat
#   04 shear at rate to the strain gmax (Lees-Edwards + Langevin on the deviation from the linear profile + barostat on z, Lin's thesis), then nvs
#      velocity steps of the strain gstep each at rate x vfac^k                           -> shear_<s>.dat, particles_<s>.*.dat, prof_<s>.*.dat, shear_<s>_all_*.dump
#   05 hold: NPzT nhold at sigma from the end of the shear at "rate"                      -> heal_<s>.dat, heal_<s>_final.data
#   Production (default, dt 1 fs): 01 0.1 + 0.1 ns, 02 10 x 0.2 ns, 03 0.1-1 ns, 04 1e9 /s to strain 1 (1 ns), 3.2e9 /s +0.5, 1e10 /s +0.5 (0.2 ns),
#   05 0.05 ns: about 2.2 ns + 2 x 2.4 ns = 7 ns.  -var nfac 2: 02-05 twice as long (04: twice the strain).
#   Outputs: about 200 lines per run in the .dat files, 20 frames per run in the trajectories (03: 5 per piece, 04: 50 per phase).
#   lmp -in in.all -var data gouge.data -var settings gouge.settings                 both normal stresses (5.6 and 56 MPa)
#   lmp -in in.all -var data gouge.data -var settings gouge.settings -var sig1 56 -var sig2 0 -var nrun 2000     a quick test
#   PBS: ./go.sh 22 "5.6 56" one 4   (3rd argument "one": the jobs of the chain run this file in RUN_N22_one)
# Continued: each run ends with all.restart and all.state (what comes next); a run that the time limit (-var tlimit, s) stops writes them too, so
# started again in the same folder, this file goes on where it stopped, also inside a run.
variable data index gouge.data
variable settings index gouge.settings
variable nrun index 0                 # 0: the production lengths below;  N > 0: a test, every run N steps (03: one piece; 04: N per phase)
variable neq index 100000             # 01: steps of the NVT and of the NPzT run (100 ps each)
variable ndwell index 200000          # 02: steps after each water removal (200 ps: time for the particles to come together)
variable ncons index 50000            # 03: steps of each piece of the consolidation (50 ps)
variable constol index 0.001          # 03: done when Lz (mean of the last tenth of a piece) changed by less than this fraction over a piece
variable nconsmax index 20            # 03: at most this many pieces (1 ns)
variable nhold index 50000            # 05: steps of the hold (50 ps)
variable nfac index 1                 # 02, 03, 04, 05 nfac x as long (04: nfac x the strain) (go.sh: NFAC=2)
variable sig1 index 5.6               # MPa
variable sig2 index 56                # MPa; 0 = none
variable final_mwmc index 0.2         # 02: water / clay mass ratio at its end
variable ndry index 10                # 02: number of water removals (each about the same number of molecules), each followed by nrun steps
variable rate index 1.0e-6            # 04: first shear rate in 1/fs (1.0e-6 = 1e9 /s)
variable gmax index 1.0               # 04: shear strain at the first rate
variable gstep index 0.5              # 04: shear strain of each velocity step
variable nvs index 2                  # 04: velocity steps after the first rate (2: 1e9 -> 3.2e9 -> 1e10 /s; 0 = none)
variable vfac index 3.16227766        # 04: rate factor from one velocity step to the next
variable flow index 1                 # 04: 1 Langevin on the deviation from the linear profile (Lin), 2 Langevin on vy only, 3 no thermostat
variable Tdamp index 1000.0           # fs, 04 Langevin
variable Pdamp index 10000.0          # fs, 04 barostat on z
variable nz index 40                  # 04: layers of the velocity profile
variable miniter index 2000           # 01: largest number of minimisation iterations
variable rc index 12.0                # real-space cutoff (A)
variable acc index 1.0e-4             # PPPM accuracy
variable dt index 1.0                 # fs
variable T index 300.0                # K
variable nclay index 18               # clay atom types 1..nclay (particles + Na)
variable thw index 19
variable tow index 20
variable seed index 12345
variable dump_group index clay        # atoms in the trajectories (clay or all)
variable tlimit index off             # s of wall time for this LAMMPS (job.sh sets it from the PBS wall time).  Given: ONE run, then LAMMPS ends
                                      # (job.sh starts it again with the time left: no clock is needed in here, any LAMMPS version)
# the steps of each kind of run (tst 1: a test, every run nrun steps)
variable tst equal $(v_nrun>0)
variable nb equal $(v_tst*v_nrun+(1-v_tst)*5000)
variable LEQ equal $(round(v_tst*v_nrun+(1-v_tst)*v_neq))
variable LDW equal $(round((v_tst*v_nrun+(1-v_tst)*v_ndwell)*v_nfac))
variable LCO equal $(100*round((v_tst*v_nrun+(1-v_tst)*v_ncons)*v_nfac/100)+100*(round((v_tst*v_nrun+(1-v_tst)*v_ncons)*v_nfac/100)<1))
variable NCM equal $(v_tst+(1-v_tst)*v_nconsmax)
variable LHO equal $(round((v_tst*v_nrun+(1-v_tst)*v_nhold)*v_nfac))
variable nout equal $(10*round(v_nb/100)+10*(round(v_nb/100)<1))   # smallest output interval (a multiple of 10)
# per run (set at its start): nso = interval of the .dat lines and thermo (about 200 per run), ndump = of the trajectory frames
variable nso equal ${nout}
variable ndump equal ${nout}
variable nextpr equal (floor((step+v_nso-1)/v_nso)+1)*v_nso   # lines of the .dat files: from one interval after the start of a run
log log.one append

# where the calculation is: st = the next run (min nvt npt dry cons shear heal end: 01 01 01 02 03 04 05), is = 1 or 2 (sig1, sig2),
# kc = water removals done, kk = shear phase, mid = 1: the run st was stopped by the time limit (all.restart is its state then)
variable st string min
variable mid equal 0
variable quitnow equal 0
variable is equal 1
variable kc equal 0
variable nw0 equal -1
variable kk equal 0
variable Gb equal 0.0
variable rprev equal 0.0
variable kcs equal 0
variable lzp equal 0.0
# S0, S1: first and last step of the run st (kept in all.state: a run stopped by the time limit ends where it was to end, also when nrun or
# nfac were changed meanwhile; S1 = -1: an all.state of an earlier version, whose runs end at the multiples of nrun)
variable S0 equal 0
variable S1 equal -1
# go on from all.state when it is there (always: also with a job script that does not give -var resume).  print ... append makes the file
# when it is missing (no is_file() in every LAMMPS): a new folder starts from the beginning.  From the beginning again: delete all.state.
variable resume index 0
print "# all.state: where in.all is" append all.state screen no
include all.state
# an all.state of the first version of this file
if "${st} == equil1" then "variable st string min"
if "${st} == equil2" then "variable st string npt"

# ================= every run: a fresh LAMMPS state, the input of the run (data file or all.restart), common settings =================
label unit
clear
if "x${tlimit} != xoff" then "timer timeout ${tlimit} every 10"
if "${st} == end" then "jump SELF s_end"
if "${is} == 1" then "variable sigma equal ${sig1}" else "variable sigma equal ${sig2}"
variable Pn equal ${sigma}*9.86923    # atm
# the input of this run: the data file at the start of a stage, else the end of the run before (all.restart)
variable infile string all.restart
variable fromdata equal 0
if "${mid} == 0 && ${st} == min" then "variable infile string ${data}" "variable fromdata equal 1"
if "${mid} == 0 && ${st} == dry && ${kc} == 0" then "variable infile string 01_equil.data" "variable fromdata equal 1"
if "${mid} == 0 && ${st} == cons && ${kcs} == 0" then "variable infile string 02_dehydrate.data" "variable fromdata equal 1"
if "${mid} == 0 && ${st} == shear && ${kk} == 0" then "variable infile string 03_consolidate_${sigma}.data" "variable fromdata equal 1"
if "${mid} == 0 && ${st} == heal" then "variable infile string shear_${sigma}_final.data" "variable fromdata equal 1"
print "in.all: run ${st}  sigma ${sigma}  kc ${kc}  kcs ${kcs}  kk ${kk}  from ${infile} (mid ${mid})"
processors * * * file procs.txt
if "${fromdata} == 1" then "jump SELF read_data"
read_restart all.restart
jump SELF read_done
label read_data
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long ${rc}
pair_modify mix arithmetic tail no
special_bonds lj/coul 0.0 0.0 0.0
read_data ${infile}
include ${settings}
if "${st} == shear" then "change_box all triclinic"
label read_done
kspace_style pppm ${acc}
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
group clay type 1:${nclay}
group water type ${thw} ${tow}
group wO type ${tow}
timestep ${dt}
thermo_style custom step temp pe ke etotal press pxx pyy pzz pxz vol lx ly lz xz spcpu   # spcpu = time steps per second
thermo_modify lost error flush yes
thermo ${nout}
jump SELF s_${st}

# ================= 01 equilibration: minimisation, NVT, NPzT at 1 atm =================
label s_min
dump dm ${dump_group} custom ${nout} 01_equil.dump id mol type xu yu zu
if "${mid} == 1" then "dump_modify dm append yes"
variable tset equal $(timeremain>0)
thermo 100
# the iterations done by the jobs before (a minimisation stopped by the time limit goes on: step = iterations done) count: at most miniter in all
variable mleft equal $(v_miniter-step)
print "in.all: minimisation, ${mleft} of ${miniter} iterations left"
if "${mleft} > 0" then "minimize 1.0e-4 1.0e-6 ${mleft} $(10*v_miniter)"
if "${tset} > 0 && $(timeremain) <= 0" then "jump SELF stop"
undump dm
reset_timestep 0
variable st string nvt
jump SELF next

label s_nvt
if "${mid} == 0" then "velocity all create ${T} ${seed} dist gaussian mom yes rot yes"
if "${mid} == 0" then "variable S0 equal $(step)" "variable S1 equal $(step+v_LEQ)"
if "${mid} == 1 && ${S1} < 0" then "variable S0 equal $(0)" "variable S1 equal $(v_nb)"
variable nso equal $(v_nout*(1+floor((v_S1-v_S0)/(200*v_nout))))
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(20*v_nout))))
thermo ${nso}
dump dm ${dump_group} custom ${ndump} 01_equil.dump id mol type xu yu zu
dump_modify dm append yes
fix fnvt all nvt temp ${T} ${T} 100.0
run ${S1} upto
if "$(step) < ${S1}" then "jump SELF stop"
variable st string npt
jump SELF next

label s_npt
if "${mid} == 0" then "variable S0 equal $(step)" "variable S1 equal $(step+v_LEQ)"
if "${mid} == 1 && ${S1} < 0" then "variable S0 equal $(v_nb)" "variable S1 equal $(2*v_nb)"
variable nso equal $(v_nout*(1+floor((v_S1-v_S0)/(200*v_nout))))
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(20*v_nout))))
thermo ${nso}
dump dm ${dump_group} custom ${ndump} 01_equil.dump id mol type xu yu zu
dump_modify dm append yes
fix fnpt all npt temp ${T} ${T} 100.0 z 1.0 1.0 1000.0
run ${S1} upto
if "$(step) < ${S1}" then "jump SELF stop"
write_data 01_equil.data
print "DONE 01" file 01_equil.done
variable st string dry
variable kc equal 0
jump SELF next

# ================= 02 dehydration: removal kc+1 of ndry =================
label s_dry
if "${kc} == 0 && ${mid} == 0" then "print '# k  n_water  mw/mc  rho_b(g/cm3)  lz(A)  S-free' file dehydrate.dat" "variable nw0 equal $(count(wO))" "print '$(count(wO))' file dehyd_nw0.txt"
# each water molecule is removed with probability ndel / n_water: about ndel of them; the last removal reaches final_mwmc
variable ntgt equal $(round(v_final_mwmc*mass(clay)/18.0153))
variable ndel equal $((count(wO)-v_ntgt)/(v_ndry-v_kc))
if "${ndel} > 0 && ${mid} == 0" then "variable rsel atom type==${tow}&&random(0,1,$(v_seed+v_kc+1))<$(v_ndel/count(wO))" "group gdel variable rsel" "delete_atoms group gdel mol yes bond yes compress yes"
print "in.all: 02 removal $(v_kc+1) of ${ndry}: $(count(wO)) water molecules left (target ${ntgt})"
if "${mid} == 0" then "variable S0 equal $(step)" "variable S1 equal $(step+v_LDW)"
if "${mid} == 1 && ${S1} < 0" then "variable S0 equal $(v_kc*v_nb)" "variable S1 equal $((v_kc+1)*v_nb)"
variable nso equal $(v_nout*(1+floor((v_S1-v_S0)/(200*v_nout))))
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(20*v_nout))))
thermo ${nso}
dump dm ${dump_group} custom ${ndump} 02_dehydrate.dump id mol type xu yu zu
dump_modify dm append yes
fix fnpt all npt temp ${T} ${T} 100.0 z 1.0 1.0 1000.0
run ${S1} upto
if "$(step) < ${S1}" then "jump SELF stop"
print "$(v_kc+1) $(count(wO)) $(mass(water)/mass(clay):%.4f) $(mass(clay)*1.66054/vol:%.4f) $(lz:%.3f) 0" append dehydrate.dat
variable kc equal $(v_kc+1)
if "${kc} >= ${ndry}" then "write_data 02_dehydrate.data" "print 'DONE 02' file 02_dehydrate.done" "variable st string cons" "variable is equal 1"
jump SELF next

# ================= 03 consolidation at sigma =================
label s_cons
# piece kcs+1 of LCO steps (the pieces end at the multiples of LCO: the consolidation starts at step 0); done when the mean Lz of the last
# tenth of a piece changed by less than constol since the piece before (at least 2 pieces), or after NCM pieces
variable lzv equal lz
variable dens equal mass(clay)*1.66054/vol
if "${mid} == 0" then "variable S0 equal $(step)" "variable S1 equal $(step+v_LCO)"
if "${mid} == 1 && ${S1} < 0" then "variable S0 equal $(0)" "variable S1 equal $(v_nb)"
variable nso equal $(v_nout*(1+floor((v_S1-v_S0)/(200*v_nout))))
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(20*v_nout))))
thermo ${nso}
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(5*v_nout))))
fix fnpt all npt temp ${T} ${T} 100.0 z ${Pn} ${Pn} 1000.0
fix av all ave/time $(v_nso/10) 10 ${nso} v_lzv v_dens
fix lzc all ave/time 10 $(v_LCO/100) $(v_LCO/10) v_lzv
if "${mid} == 0 && ${kcs} == 0" then "print '# TimeStep v_lzv v_dens' file 03_consolidate_${sigma}.dat"
fix pr all print v_nextpr "$(step) $(f_av[1]:%.6g) $(f_av[2]:%.6g)" append 03_consolidate_${sigma}.dat screen no
dump dm ${dump_group} custom ${ndump} 03_consolidate_${sigma}.dump id mol type xu yu zu
if "${mid} == 1 || ${kcs} > 0" then "dump_modify dm append yes"
print "in.all: 03 at ${sigma} MPa, piece $(v_kcs+1) of at most ${NCM}: steps ${S0} -> ${S1}"
run ${S1} upto
if "$(step) < ${S1}" then "jump SELF stop"
variable lzn equal $(f_lzc+(f_lzc==0)*lz)
variable dlz equal $(abs(v_lzn-v_lzp)/v_lzn)
variable kcs equal $(v_kcs+1)
variable lzp equal ${lzn}
variable cdone equal $((v_kcs>=v_NCM)||((v_kcs>=2)&&(v_dlz<v_constol)))
print "in.all: 03 at ${sigma} MPa, piece ${kcs}: Lz $(v_lzn:%.3f) A, change $(v_dlz:%.5f) over the piece (done below ${constol}): done ${cdone}"
print "$(step) $(v_lzn:%.4f) $(v_dlz:%.6f)" append 03_consolidate_${sigma}.pieces
if "${cdone} == 0" then "jump SELF next"
variable kcs equal 0
variable lzp equal 0.0
write_data 03_consolidate_${sigma}.data
print "DONE 03" file 03_consolidate_${sigma}.done
variable st string shear
variable kk equal 0
variable Gb equal 0.0
variable rprev equal 0.0
jump SELF next

# ================= 04 shear: phase kk (0 = rate, then the velocity steps) =================
label s_shear
variable rk equal $(v_rate*v_vfac^v_kk)
# steps of this phase: the strain gmax (first rate) or gstep (velocity steps) at this rate, x nfac; a test (nrun > 0): nrun
variable gk equal $(v_gmax*(v_kk==0)+v_gstep*(v_kk>0))
variable L0 equal $(v_tst*v_nrun+(1-v_tst)*((v_gk>0)*round(v_gk/(v_rk*v_dt))+(v_gk<=0)*v_nb))
if "${mid} == 0" then "variable S0 equal $(step)" "variable S1 equal $(step+round(v_L0*v_nfac))"
if "${mid} == 1 && ${S1} < 0" then "variable S0 equal $(v_kk*v_nb)" "variable S1 equal $((v_kk+1)*v_nb)"
variable nso equal $(v_nout*(1+floor((v_S1-v_S0)/(200*v_nout))))
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(20*v_nout))))
thermo ${nso}
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(50*v_nout))))
variable Sb equal ${S0}
variable Se equal ${S1}
print "in.all: 04 phase ${kk}: rate $(v_rk*1e15:%.4g) /s, steps ${Sb} -> ${Se}, strain ${Gb} -> $(v_Gb+(v_Se-v_Sb)*v_rk*v_dt)"
compute tdef all temp/deform
thermo_modify temp tdef
compute ty all temp/partial 0 1 0
fix fs all nph z ${Pn} ${Pn} ${Pdamp} dilate all
fix_modify fs temp tdef
if "${flow} == 1" then "fix fl all langevin ${T} ${T} ${Tdamp} ${seed}" "fix_modify fl temp tdef"
if "${flow} == 2" then "fix fl all langevin ${T} ${T} ${Tdamp} ${seed}" "fix_modify fl temp ty"
compute pt all pressure tdef
variable gam equal ${Gb}+${rk}*${dt}*(step-${Sb})
variable ss equal -c_pt[5]*0.101325
variable sn equal c_pt[3]*0.101325
variable mu equal v_ss/v_sn
variable dens equal mass(clay)*1.66054/vol
variable lzv equal lz
variable lxv equal lx
variable lyv equal ly
variable rks equal ${rk}*1e15
fix av all ave/time $(v_nso/10) 10 ${nso} v_gam v_ss v_sn v_mu v_lzv v_dens c_tdef v_lxv v_lyv v_rks
if "${kk} == 0 && ${mid} == 0" then "print '# TimeStep gamma tau(MPa) sigma_n(MPa) mu Lz(A) rho_b(g/cm3) T(K) Lx(A) Ly(A) rate(1/s)' file shear_${sigma}.dat" "print 'in.all with phases' file shear_${sigma}.v2"
fix pr all print v_nextpr "$(step) $(f_av[1]:%.6g) $(f_av[2]:%.6g) $(f_av[3]:%.6g) $(f_av[4]:%.6g) $(f_av[5]:%.6g) $(f_av[6]:%.6g) $(f_av[7]:%.5g) $(f_av[8]:%.6g) $(f_av[9]:%.6g) $(f_av[10]:%.5g)" append shear_${sigma}.dat screen no
# particles (clay without Na): centre of mass, velocity, gyration tensor, internal temperature;  profiles across the gouge
variable isna atom abs(mass-22.98977)<0.01
group na variable isna
group part subtract clay na
compute cpart part chunk/atom molecule nchunk once ids once compress yes
compute pcom part com/chunk cpart
compute pvcm part vcm/chunk cpart
compute pgyr part gyration/chunk cpart tensor
compute ptmp part temp/chunk cpart temp com yes
compute czw water chunk/atom bin/1d z lower $(1.000001/v_nz) units reduced
compute czc part chunk/atom bin/1d z lower $(1.000001/v_nz) units reduced
compute cza all chunk/atom bin/1d z lower $(1.000001/v_nz) units reduced
compute zpw water property/chunk czw count coord1
compute zpc part property/chunk czc count
compute zvw water vcm/chunk czw
compute zvc part vcm/chunk czc
compute zta all temp/chunk cza temp com yes
if "${kk} == 0 && ${mid} == 0" then "write_dump all custom shear_${sigma}_all_0.dump id mol type xu yu zu"
# the shear: the box tilt grows at rk*Lz (Lees-Edwards); the change of the flow profile is added to the velocities at the start of the phase
# (not when a stopped phase goes on: its velocities have it)
fix fd all deform 1 xz erate ${rk} remap v units box
if "${flow} > 0 && ${mid} == 0" then "velocity all ramp vx 0.0 $((v_rk-v_rprev)*lz) z $(zlo) $(zhi) sum yes units box"
fix fpart part ave/time $(v_nso/5) 1 $(v_nso/5) c_pcom[1] c_pcom[2] c_pcom[3] c_pvcm[1] c_pvcm[2] c_pvcm[3] c_pgyr[1] c_pgyr[2] c_pgyr[3] c_pgyr[4] c_pgyr[5] c_pgyr[6] c_ptmp[1] mode vector file particles_${sigma}.$(step).dat
fix fprof all ave/time $(v_nso/10) 10 ${nso} c_zpw[2] c_zpw[1] c_zvw[1] c_zpc c_zvc[1] c_zta[1] mode vector file prof_${sigma}.$(step).dat
dump dm ${dump_group} custom ${ndump} shear_${sigma}.dump id mol type xu yu zu
dump_modify dm append yes
run ${Se} upto
if "$(step) < ${Se}" then "jump SELF stop"
write_dump all custom shear_${sigma}_all_$(step).dump id mol type xu yu zu
if "${kk} == 0" then "write_data shear_${sigma}_final.data"
variable Gb equal $(v_Gb+(v_Se-v_Sb)*v_rk*v_dt)
variable rprev equal ${rk}
variable kk equal $(v_kk+1)
if "${kk} > ${nvs}" then "print 'DONE 04' file shear_${sigma}.done" "variable st string heal"
jump SELF next

# ================= 05 hold at sigma after the shear =================
label s_heal
compute pt all pressure thermo_temp
variable ss equal -c_pt[5]*0.101325
variable sn equal c_pt[3]*0.101325
variable dens equal mass(clay)*1.66054/vol
variable lzv equal lz
if "${mid} == 0" then "variable S0 equal $(step)" "variable S1 equal $(step+v_LHO)"
if "${mid} == 1 && ${S1} < 0" then "variable S0 equal $(0)" "variable S1 equal $(v_nb)"
variable nso equal $(v_nout*(1+floor((v_S1-v_S0)/(200*v_nout))))
variable ndump equal $(v_nout*(1+floor((v_S1-v_S0)/(20*v_nout))))
thermo ${nso}
fix fnpt all npt temp ${T} ${T} 100.0 z ${Pn} ${Pn} 1000.0
fix av all ave/time $(v_nso/10) 10 ${nso} v_ss v_sn v_lzv v_dens
if "${mid} == 0" then "print '# TimeStep v_ss v_sn v_lzv v_dens' file heal_${sigma}.dat"
fix pr all print v_nextpr "$(step) $(f_av[1]:%.6g) $(f_av[2]:%.6g) $(f_av[3]:%.6g) $(f_av[4]:%.6g)" append heal_${sigma}.dat screen no
dump dm ${dump_group} custom ${ndump} heal_${sigma}.dump id mol type xu yu zu
if "${mid} == 1" then "dump_modify dm append yes"
run ${S1} upto
if "$(step) < ${S1}" then "jump SELF stop"
write_data heal_${sigma}_final.data
print "DONE 05" file heal_${sigma}.done
if "${is} == 1 && ${sig2} > 0" then "variable is equal 2" "variable st string cons" else "variable st string end"
jump SELF next

# ================= after every run: the state for the next run (and for the next job) =================
# stop: the time limit stopped run st; all.restart is its state, the next job goes on from it.  next: run done, st is the next one
label stop
variable mid equal 1
variable quitnow equal 1
jump SELF save
label next
variable mid equal 0
label save
write_restart all.restart
print "variable st string ${st}" file all.state
print "variable is equal ${is}" append all.state
print "variable kc equal ${kc}" append all.state
print "variable nw0 equal ${nw0}" append all.state
print "variable kk equal ${kk}" append all.state
print "variable Gb equal ${Gb}" append all.state
print "variable rprev equal ${rprev}" append all.state
print "variable kcs equal ${kcs}" append all.state
print "variable lzp equal ${lzp}" append all.state
print "variable mid equal ${mid}" append all.state
print "variable S0 equal ${S0}" append all.state
print "variable S1 equal ${S1}" append all.state
if "${quitnow} == 1" then "print 'in.all: the time limit stopped ${st} at step $(step); the next job goes on from all.restart'" "quit 0"
if "x${tlimit} != xoff" then "print 'in.all: run done, next: ${st} (one run per LAMMPS when tlimit is given; job.sh starts the next one)'" "quit 0"
jump SELF unit

label s_end
print "DONE all" file all.done
print "in.all: all runs done"
