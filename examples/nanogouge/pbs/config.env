# Settings of the supercomputer.  Fill these in from /home/app/lammps/run.sh (the centre's sample script):
#   its "#PBS" lines -> QUEUE / SELECT / WALLTIME_*, its "module load ..." line -> MODULES,
#   its "mpirun ..." / "lmp ..." line -> MPIRUN / LMP.
QUEUE=""                                   # queue name (empty = the default queue)
SELECT="select=4:ncpus=32:mpiprocs=32"     # PBS Pro:  select=<nodes>:ncpus=<cores per node>:mpiprocs=<MPI per node>
                                           # (Torque: "nodes=4:ppn=32" and set RES_KEY=nodes below)
RES_FLAG="-l"                              # qsub resource flag
WALLTIME_SHORT="12:00:00"                  # stages 01, 03, 05
WALLTIME_LONG="48:00:00"                   # stages 02 and 04 (restart-able: the chain re-submits)
MODULES=""                                 # e.g. 'module load intel openmpi lammps'
LMP="lmp"                                  # LAMMPS executable (needs KSPACE, MOLECULE)
                                           # if LAMMPS is in a Singularity image:  LMP="singularity exec /path/to/lammps.sif lmp"
                                           #   (add --bind $PWD if the run folder is not visible; if mpirun is inside the image: MPIRUN="singularity exec /path/to/lammps.sif mpirun")
                                           # the build step (go.sh) can use the image too:  PYTHON="singularity exec /path/to/x.sif python3" ./go.sh
MPIRUN="mpirun"                            # or mpiexec / mpiexec.hydra / "mpirun -machinefile $PBS_NODEFILE"
N_DEHYD_JOBS=2                             # stage 02 (dehydration) is a chain of this many jobs
N_SHEAR_JOBS=3                             # stage 04 is a chain of this many jobs (each continues from the last restart file)

# ---- Singularity and cores ---------------------------------------------------------------------------------
SIF=""                                     # path of the LAMMPS Singularity image (empty = LAMMPS is installed on the node: LMP is used as it is)
SING_OPTS=""                               # extra options of "singularity exec", e.g. "--nv" is NOT needed; "--bind /work" if the run folder is under another path
LMP_IN_IMAGE="lmp"                         # name of the LAMMPS executable inside the image (lmp, lmp_mpi, ...)
CORES_PER_NODE="${CORES_PER_NODE:-}"                          # empty = every core the job may use on each node (nproc); this is how all cores are used
HOSTFILE_FMT="openmpi"                     # "openmpi" (host slots=N, mpirun --hostfile) or "mpich" (host:N, mpirun -machinefile; Intel MPI / MPICH)
