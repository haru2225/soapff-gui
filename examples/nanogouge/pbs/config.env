# OPTIONAL overrides.  Normally nothing here needs to be edited: ./go.sh reads the centre's sample script
# (/home/app/lammps/run.sh, or CONFIG_SRC=/path/run.sh) and writes config.auto.  Uncomment a line only to override what was detected.
#QSUB_OPTS="-q QUEUE -l select=4:ncpus=128:mpiprocs=128 -l walltime=24:00:00"   # all qsub options of the jobs
#MODULES="module load lammps"
#SIF="/path/to/lammps.sif"; LMP_IN_IMAGE="lmp"; SING_OPTS=""                   # Singularity image
#LMP="lmp"                                                                      # LAMMPS on the node (no image)
#MPIRUN="mpirun"; HOSTFILE_FMT="openmpi"                                        # "mpich" for Intel MPI / MPICH
#CORES_PER_NODE=""                                                              # empty = every core of every node (nproc)
N_DEHYD_JOBS=${N_DEHYD_JOBS:-2}            # chain lengths: a job stopped by the wall time is followed by the next one
N_SHEAR_JOBS=${N_SHEAR_JOBS:-3}
