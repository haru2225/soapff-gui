region sw_hi block INF INF INF INF 8.2446436326107903625 EDGE units box
region sw_il union 2 sw_lo sw_hi
variable sw_k equal $(v_sw_k+1)
variable sw_k equal 1
variable sw_before equal $(v_sw_nw)
variable sw_before equal 0
