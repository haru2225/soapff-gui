# swelling curve (soapff; Cygan et al. 2004): water added to the interlayer (10 states), each state NPT 30 ps + 20 ps (recorded); d001 = lz in swelling.dat
velocity all create 300 4928459 mom yes rot no dist gaussian
timestep 0.5
shell rm -f swelling_states.lammpstrj
molecule h2o water.mol
Read molecule template h2o:
# flexible SPC (ClayFF) water, written by soapff-cui
  1 molecules
  0 fragments
  3 atoms with max type 12
  2 bonds with max type 2
  1 angles with max type 1
  0 dihedrals with max type 0
  0 impropers with max type 0
group sw_clay type 1 2 3 5 7 8 9 10 11 13
160 atoms in group sw_clay
variable sw_nw equal (atoms-163)/3-0
variable sw_step equal step
variable sw_lx equal lx
variable sw_ly equal ly
variable sw_lz equal lz
variable sw_xy equal xy
variable sw_xz equal xz
variable sw_yz equal yz
variable sw_pe equal pe
variable sw_temp equal temp
print "# step added_waters phase lx ly lz xy xz yz pe temp" file swelling.dat screen no
variable sw_k equal 0
region sw_lo block INF INF INF INF EDGE 0.1 units box
region sw_hi block INF INF INF INF 0.2 EDGE units box
region sw_il union 2 sw_lo sw_hi
variable sw_add index 4 8 12 16 20 25 32 40 48 59
label sw_up
label sw_ins
region sw_il delete
region sw_lo delete
region sw_hi delete
variable sw_z1 equal $(bound(sw_clay,zmin)-0.3)
variable sw_z1 equal 1.0781350295081162383
