# soapff-cui settings: ClayFF (Cygan et al. 2004, Tables 1 and 2) with flexible SPC (ClayFF) water; types in system.data from SOAP, charges: clayff2004
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
pair_coeff 1 1 0.0 0.0  # ho
pair_coeff 2 2 0.0 0.0  # hw
pair_coeff 3 3 9.0298e-07 5.264320525491264  # mgh
pair_coeff 4 4 0.1554 3.1655413252962536  # oh
pair_coeff 5 5 0.1554 3.1655413252962536  # ow
bond_coeff 1 554.1349 1.0  # O-H
bond_coeff 2 554.1349 1.0  # O-H (water)
angle_coeff 1 45.7696 109.47  # HOHw
angle_coeff 2 30.0 109.47  # MOH-Mg-bulk
kspace_style pppm 1.0e-5
