pair_coeff 1 1 0.0 0.0  # ho
pair_coeff 2 2 0.0 0.0  # hw
pair_coeff 3 3 9.0298e-07 5.264320525491264  # mgh
pair_coeff 4 4 0.1554 3.1655413252962536  # ob
pair_coeff 5 5 0.1554 3.1655413252962536  # oh
pair_coeff 6 6 0.1554 3.1655413252962536  # ow
pair_coeff 7 7 1.8405e-06 3.3020270089153536  # st
bond_coeff 1 554.1349 1.0  # O-H
bond_coeff 2 554.1349 1.0  # O-H (water)
angle_coeff 1 45.7696 109.47  # HOHw
angle_coeff 2 30.0 109.47  # MOH-Mg-bulk
kspace_style pppm 1.0e-5
group water type 6 2
471 atoms in group water
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000
