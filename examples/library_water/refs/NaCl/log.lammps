# soapff-cui: ClayFF + SOAP charges.  lmp -in in.lammps
include system.settings
# soapff-cui settings: ClayFF (Cygan et al. 2004, Tables 1 and 2) with flexible SPC (ClayFF) water; types in system.data from SOAP, charges: clayff2004
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
Reading data file ...
  orthogonal box = (0 0 0) to (24.83 24.83 24.83)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  1504 atoms
  scanning bonds ...
  2 = max bonds/atom
  scanning angles ...
  1 = max angles/atom
  orthogonal box = (0 0 0) to (24.83 24.83 24.83)
  1 by 1 by 1 MPI processor grid
  reading bonds ...
  992 bonds
  reading angles ...
  496 angles
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     2 = max # of 1-2 neighbors
     1 = max # of 1-3 neighbors
     1 = max # of 1-4 neighbors
     2 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.010 seconds
pair_coeff 1 1 0.1001 4.399970589151507  # Cl
pair_coeff 2 2 0.0 0.0  # hw
pair_coeff 3 3 0.1301 2.350012638710587  # Na
pair_coeff 4 4 0.1554 3.1655413252962536  # ow
bond_coeff 1 554.1349 1.0  # O-H (water)
angle_coeff 1 45.7696 109.47  # HOHw
kspace_style pppm 1.0e-5
group water type 4 2
1488 atoms in group water
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000

