pair_coeff 1 1 0.1 2.8719901976690116  # Ca
pair_coeff 2 2 0.1001 4.399970589151507  # Cl
pair_coeff 3 3 0.0 0.0  # hw
pair_coeff 4 4 0.1554 3.1655413252962536  # ow
bond_coeff 1 554.1349 1.0  # O-H (water)
angle_coeff 1 45.7696 109.47  # HOHw
kspace_style pppm 1.0e-5
group water type 4 3
1482 atoms in group water
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000
