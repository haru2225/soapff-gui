pair_coeff 11 11 0.1554 3.1655  # oaa (Montmorillonite edge)
pair_coeff 12 12 0.1554 3.1655  # oab (Montmorillonite edge)
pair_coeff 13 13 0.1554 3.1655  # ob (Montmorillonite edge)
pair_coeff 14 14 0.1554 3.1655  # obos (Montmorillonite edge)
pair_coeff 15 15 0.1554 3.1655  # oed (Montmorillonite edge)
pair_coeff 16 16 0.1554 3.1655  # oh (Montmorillonite edge)
