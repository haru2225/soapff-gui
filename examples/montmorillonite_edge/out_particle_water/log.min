pair_coeff 18 18 0.1554 3.1655  # oma (Montmorillonite edge)
pair_coeff 19 19 0.1554 3.1655  # omb (Montmorillonite edge)
pair_coeff 20 20 0.1554 3.1655413252962536  # ow
pair_coeff 21 21 1.8405e-06 3.302  # st (Montmorillonite edge)
bond_coeff 1 553.935 1.0  # O-H (Montmorillonite edge)
bond_coeff 2 554.1349 1.0  # O-H (water)
angle_coeff 1 45.7696 109.47  # HOHw
angle_coeff 2 30.0191 109.47  # MOH-Al-bulk (Montmorillonite edge)
angle_coeff 3 30.0191 109.47  # MOH-Al-surface (Montmorillonite edge)
angle_coeff 4 30.0191 109.47  # MOH-Mg-bulk (Montmorillonite edge)
angle_coeff 5 30.0191 109.47  # MOH-Mg-surface (Montmorillonite edge)
angle_coeff 6 30.0191 109.47  # MOH-Si-surface (Montmorillonite edge)
angle_coeff 7 800.0 100.0  # MOMe  (edge metal-O-metal) (Montmorillonite edge)
kspace_style ewald 1.0e-4
group water type 20 6
7680 atoms in group water
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000
