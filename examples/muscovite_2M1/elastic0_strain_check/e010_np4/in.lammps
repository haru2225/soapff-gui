# soapff-cui: ClayFF + SOAP charges.  lmp -in in.lammps
include system.settings
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000
min_modify dmax 0.1
minimize 1.0e-6 1.0e-6 5000 50000
change_box all triclinic
kspace_style pppm 1.0e-5

# Add the MD (fix, compute, run, etc.) below this line (+ fix / + compute / + Other)

# ===== soapff: property calculation (0 K elastic constants, tension / compression, shear) =====
# (change_box all triclinic is needed for the tilt factors: it is placed before any dump)

# soapff-property: elastic0 strain=0.01 file=elastic0.dat
# 0 K elastic constants (LAMMPS examples/ELASTIC): zero-stress box, then +-strain per direction, atoms relaxed
velocity all set 0.0 0.0 0.0
# zero-stress box: box/relax and fixed-box minimisations alternated 4 times (box/relax alone leaves the
# atoms unrelaxed); the last fixed-box minimisation is the reference, relaxed as the strained states
fix soapff_br all box/relax tri 0.0 vmax 0.001 nreset 20
minimize 0.0 1.0e-8 20000 200000
unfix soapff_br
minimize 0.0 1.0e-8 20000 200000
fix soapff_br all box/relax tri 0.0 vmax 0.001 nreset 20
minimize 0.0 1.0e-8 20000 200000
unfix soapff_br
minimize 0.0 1.0e-8 20000 200000
fix soapff_br all box/relax tri 0.0 vmax 0.001 nreset 20
minimize 0.0 1.0e-8 20000 200000
unfix soapff_br
minimize 0.0 1.0e-8 20000 200000
fix soapff_br all box/relax tri 0.0 vmax 0.001 nreset 20
minimize 0.0 1.0e-8 20000 200000
unfix soapff_br
minimize 0.0 1.0e-8 20000 200000
print "# dir sign strain pxx pyy pzz pyz pxz pxy (atm) lx ly lz xy xz yz" file elastic0.dat screen no
print "0 0 0 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
reset_timestep 0
write_dump all custom soapff_e0.dump id x y z ix iy iz modify sort id
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all x delta 0 $(-0.01*lx) xy delta $(-0.01*xy) xz delta $(-0.01*xz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "1 -1 -0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all x delta 0 $(0.01*lx) xy delta $(0.01*xy) xz delta $(0.01*xz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "1 1 0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all y delta 0 $(-0.01*ly) yz delta $(-0.01*yz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "2 -1 -0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all y delta 0 $(0.01*ly) yz delta $(0.01*yz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "2 1 0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all z delta 0 $(-0.01*lz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "3 -1 -0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all z delta 0 $(0.01*lz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "3 1 0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all yz delta $(-0.01*lz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "4 -1 -0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all yz delta $(0.01*lz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "4 1 0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all xz delta $(-0.01*lz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "5 -1 -0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all xz delta $(0.01*lz) remap units box
minimize 0.0 1.0e-8 20000 200000
print "5 1 0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all xy delta $(-0.01*ly) remap units box
minimize 0.0 1.0e-8 20000 200000
print "6 -1 -0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes
change_box all xy delta $(0.01*ly) remap units box
minimize 0.0 1.0e-8 20000 200000
print "6 1 0.01 $(pxx) $(pyy) $(pzz) $(pyz) $(pxz) $(pxy) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" append elastic0.dat screen no
read_dump soapff_e0.dump 0 x y z ix iy iz box yes replace yes

# soapff: equilibration at 300 K (NVT 10 ps, NPT 20 ps at 1 atm, tri; box set to its NPT average)
velocity all create 300 4928459 mom yes rot no dist gaussian
timestep 0.5
fix soapff_eq all nvt temp 300 300 100
run 20000
unfix soapff_eq
reset_timestep 0
fix soapff_eq all npt temp 300 300 100 tri 1 1 1000
run 20000
# the box averaged over the second half of the NPT only (the first half still relaxes the volume)
variable soapff_lx equal lx
variable soapff_ly equal ly
variable soapff_lz equal lz
variable soapff_xy equal xy
variable soapff_xz equal xz
variable soapff_yz equal yz
fix soapff_box all ave/time 10 100 1000 v_soapff_lx v_soapff_ly v_soapff_lz v_soapff_xy v_soapff_xz v_soapff_yz ave running
run 20000
unfix soapff_eq
change_box all x final $(xlo) $(xlo+f_soapff_box[1]) y final $(ylo) $(ylo+f_soapff_box[2]) z final $(zlo) $(zlo+f_soapff_box[3]) remap units box
change_box all xy final $(f_soapff_box[4]) xz final $(f_soapff_box[5]) yz final $(f_soapff_box[6]) remap units box
unfix soapff_box
reset_timestep 0
write_dump all custom soapff_eq.dump id x y z vx vy vz ix iy iz modify sort id

