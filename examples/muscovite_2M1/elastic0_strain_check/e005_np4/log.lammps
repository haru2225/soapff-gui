  special bonds CPU = 0.000 seconds
  read_data CPU = 0.004 seconds
pair_coeff 1 1 1.3298e-06 4.271235724380229  # ao
pair_coeff 2 2 1.8405e-06 3.3020270089153536  # at
pair_coeff 3 3 0.0 0.0  # ho
pair_coeff 4 4 0.1 3.3340102728965917  # K
pair_coeff 5 5 0.1554 3.1655413252962536  # ob
pair_coeff 6 6 0.1554 3.1655413252962536  # obts
pair_coeff 7 7 0.1554 3.1655413252962536  # oh
pair_coeff 8 8 1.8405e-06 3.3020270089153536  # st
bond_coeff 1 554.1349 1.0  # O-H
angle_coeff 1 30.0 109.47  # MOH-Al-bulk
kspace_style pppm 1.0e-5
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000
