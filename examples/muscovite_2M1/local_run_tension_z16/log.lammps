pair_coeff 1 1 1.3298e-06 4.27124  # ao
pair_coeff 2 2 1.8405e-06 3.30203  # at
pair_coeff 3 3 0 0  # ho
pair_coeff 4 4 0.1 3.33401  # K
pair_coeff 5 5 0.1554 3.16554  # ob
pair_coeff 6 6 0.1554 3.16554  # obts
pair_coeff 7 7 0.1554 3.16554  # oh
pair_coeff 8 8 1.8405e-06 3.30203  # st
bond_coeff 1 554.1349 1.0  # O-H
angle_coeff 1 30.0 109.47  # MOH-Al-bulk
kspace_style pppm 1.0e-5
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
change_box all triclinic
Changing box ...
  triclinic box = (0.013547171 -0.0035559468 0.19548226) to (20.718621 17.943503 19.875899) with tilt (0.01475299 -2.1077654 -0.017217773)
kspace_style pppm 1.0e-5
# muscovite 2M1 (2x2x1): tension z to strain 0.16 at 300 K from the equilibrated state of ../run (system.data,
# written from ../run/soapff_eq.dump with velocities); same commands as ../run/in.lammps
timestep 0.5
reset_timestep 0
write_dump all custom soapff_eq.dump id x y z vx vy vz ix iy iz modify sort id
WARNING: Calling write_dump before a full system init. (src/write_dump.cpp:88)

# soapff-property: tensile dir=z sign=1 rate_s=1e+09 max_strain=0.16 file=mech_tensile_z.dat
# uniaxial tension along z: fix deform erate, x and y at 1 atm (fix npt); stress = -pzz
read_dump soapff_eq.dump 0 x y z vx vy vz ix iy iz box yes replace yes
