variable soapff_T0 equal $(yz)
variable soapff_strain equal (yz-v_soapff_T0)/lz
fix soapff_t all nvt temp 300 300 100
fix soapff_def all deform 1 yz erate -1e-06 remap x flip no
fix soapff_mech all ave/time 10 10 100 v_soapff_strain c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[6] c_thermo_press[5] c_thermo_press[4] v_soapff_lx v_soapff_ly v_soapff_lz v_soapff_xy v_soapff_xz v_soapff_yz c_thermo_temp file mech_shear_yz_neg.dat
dump soapff_dm all custom 2000 traj_shear_yz_neg.lammpstrj id type element x y z ix iy iz q
dump_modify soapff_dm sort id element ao at ho K ob obts oh st
run 320000
unfix soapff_mech
unfix soapff_def
unfix soapff_t
undump soapff_dm
