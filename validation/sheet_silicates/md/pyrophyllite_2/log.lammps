LAMMPS (29 Aug 2024)
  using 1 OpenMP thread(s) per MPI task
# soapff-cui: ClayFF + SOAP charges.  lmp -in in.lammps
include system.settings
# soapff-cui settings: ClayFF (Cygan et al. 2004, Tables 1 and 2) with flexible SPC water; charges in system.data come from SOAP
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
