# soapff-cui: ClayFF + SOAP charges.  lmp -in in.lammps
include system.settings
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
thermo_style custom step temp press pe ke etotal vol density lx ly lz
thermo 1000
# minimisation with a small step limit first (built structures may contain overlapping water)
min_style cg
min_modify dmax 0.01
minimize 1.0e-4 1.0e-6 1000 10000
min_modify dmax 0.1
minimize 1.0e-6 1.0e-6 5000 50000
change_box all triclinic
kspace_style pppm 1.0e-5

# ここから下に MD（fix、compute、run など）を追加します（＋ fix / ＋ compute / ＋ その他）

# ===== soapff：物性の計算（せん断）=====
# (change_box all triclinic is needed for the tilt factors: it is placed before any dump)

# soapff: equilibration at 300 K (NVT 10 ps, NPT 20 ps at 1 atm, aniso; box set to its NPT average)
velocity all create 300 4928459 mom yes rot no dist gaussian
timestep 0.5
fix soapff_eq all nvt temp 300 300 100
run 20000
unfix soapff_eq
reset_timestep 0
fix soapff_eq all npt temp 300 300 100 aniso 1 1 1000
run 20000
# the box averaged over the second half of the NPT only (the first half still relaxes the volume)
variable soapff_lx equal lx
variable soapff_ly equal ly
variable soapff_lz equal lz
variable soapff_xy equal xy
variable soapff_xz equal xz
variable soapff_yz equal yz
fix soapff_box all ave/time 10 100 1000 v_soapff_lx v_soapff_ly v_soapff_lz v_soapff_xy v_soapff_xz v_soapff_yz ave running
run 20000
unfix soapff_eq
change_box all x final $(xlo) $(xlo+f_soapff_box[1]) y final $(ylo) $(ylo+f_soapff_box[2]) z final $(zlo) $(zlo+f_soapff_box[3]) remap units box
change_box all xy final $(f_soapff_box[4]) xz final $(f_soapff_box[5]) yz final $(f_soapff_box[6]) remap units box
unfix soapff_box
reset_timestep 0
write_dump all custom soapff_eq.dump id x y z vx vy vz ix iy iz modify sort id

# soapff-property: shear plane=xy mode=solid rate_s=1e+09 max_strain=0.2 file=mech_shear_xy.dat
# shear xy: fix deform of the tilt factor xy (engineering strain rate, flip no); solid: fix nvt, remap x; shear stress = -pxy
read_dump soapff_eq.dump 0 x y z vx vy vz ix iy iz box yes replace yes
reset_timestep 0
variable soapff_lx equal lx
variable soapff_ly equal ly
variable soapff_lz equal lz
variable soapff_xy equal xy
variable soapff_xz equal xz
variable soapff_yz equal yz
variable soapff_T0 equal $(xy)
variable soapff_strain equal (xy-v_soapff_T0)/ly
fix soapff_t all nvt temp 300 300 100
fix soapff_def all deform 1 xy erate 1e-06 remap x flip no
fix soapff_mech all ave/time 10 10 100 v_soapff_strain c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[6] c_thermo_press[5] c_thermo_press[4] v_soapff_lx v_soapff_ly v_soapff_lz v_soapff_xy v_soapff_xz v_soapff_yz c_thermo_temp file mech_shear_xy.dat

dump soapff_dm all custom 2000 traj_shear_xy.lammpstrj id type element x y z ix iy iz q
dump_modify soapff_dm sort id element ao at ho K ob obts oh st
run 400000
unfix soapff_mech
unfix soapff_def
unfix soapff_t
undump soapff_dm
