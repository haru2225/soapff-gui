# official compute heat/flux example (solid Ar, real units) + Howto viscosity scale; with the soapff output files
variable    T equal 70
variable    V equal vol
variable    dt equal 4.0
variable    p equal 200
variable    s equal 10
variable    d equal $p*$s
variable    kB equal 1.3806504e-23
variable    kCal2J equal 4186.0/6.02214e23
variable    A2m equal 1.0e-10
variable    fs2s equal 1.0e-15
variable    atm2Pa equal 101325.0
variable    convert equal ${kCal2J}*${kCal2J}/${fs2s}/${A2m}
variable    convertv equal ${atm2Pa}*${atm2Pa}*${fs2s}*${A2m}*${A2m}*${A2m}
units       real
atom_style  atomic
lattice     fcc 5.376 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1
region      box block 0 4 0 4 0 4
create_box  1 box
create_atoms 1 box
mass        1 39.948
pair_style  lj/cut 13.0
pair_coeff  * * 0.2381 3.405
timestep    ${dt}
thermo      $d
velocity    all create $T 102486 mom yes rot yes dist gaussian
fix         NVT all nvt temp $T $T 10 drag 0.2
run         8000
reset_timestep 0
compute      myKE all ke/atom
compute      myPE all pe/atom
compute      myStress all stress/atom NULL virial
compute      flux all heat/flux myKE myPE myStress
variable soapff_jx equal c_flux[1]
variable soapff_jy equal c_flux[2]
variable soapff_jz equal c_flux[3]
fix          JJ all ave/correlate $s $p $d v_soapff_jx v_soapff_jy v_soapff_jz type auto file gk_heatflux.dat ave running
variable     scale equal ${convert}/${kB}/$T/$T/$V*$s*${dt}
variable     k11 equal trap(f_JJ[3])*${scale}
variable     k22 equal trap(f_JJ[4])*${scale}
variable     k33 equal trap(f_JJ[5])*${scale}
variable soapff_pxy equal pxy
variable soapff_pxz equal pxz
variable soapff_pyz equal pyz
fix          SS all ave/correlate $s $p $d v_soapff_pxy v_soapff_pxz v_soapff_pyz type auto file gk_viscosity.dat ave running
variable     scalev equal ${convertv}/(${kB}*$T)*$V*$s*${dt}
variable     v11 equal trap(f_SS[3])*${scalev}
variable     v22 equal trap(f_SS[4])*${scalev}
variable     v33 equal trap(f_SS[5])*${scalev}
variable soapff_vol equal vol
fix soapff_state all ave/time 10 10 100 c_thermo_temp c_thermo_press v_soapff_vol c_thermo_pe file soapff_state.dat
thermo_style custom step temp press v_k11 v_k22 v_k33 v_v11 v_v22 v_v33
run          40000
variable     k equal (v_k11+v_k22+v_k33)/3.0
variable     v equal (v_v11+v_v22+v_v33)/3.0
print        "LAMMPS kappa $k W/mK  eta $v Pa.s"
