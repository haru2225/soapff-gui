reset_timestep 0
compute      myKE all ke/atom
compute      myPE all pe/atom
compute      myStress all stress/atom NULL virial
compute      flux all heat/flux myKE myPE myStress
variable soapff_jx equal c_flux[1]
variable soapff_jy equal c_flux[2]
variable soapff_jz equal c_flux[3]
fix          JJ all ave/correlate $s $p $d v_soapff_jx v_soapff_jy v_soapff_jz type auto file gk_heatflux.dat ave running
fix          JJ all ave/correlate 10 $p $d v_soapff_jx v_soapff_jy v_soapff_jz type auto file gk_heatflux.dat ave running
fix          JJ all ave/correlate 10 200 $d v_soapff_jx v_soapff_jy v_soapff_jz type auto file gk_heatflux.dat ave running
fix          JJ all ave/correlate 10 200 2000 v_soapff_jx v_soapff_jy v_soapff_jz type auto file gk_heatflux.dat ave running
variable     scale equal ${convert}/${kB}/$T/$T/$V*$s*${dt}
variable     scale equal 4.83166430676946e-16/${kB}/$T/$T/$V*$s*${dt}
variable     scale equal 4.83166430676946e-16/1.3806504e-23/$T/$T/$V*$s*${dt}
variable     scale equal 4.83166430676946e-16/1.3806504e-23/70/$T/$V*$s*${dt}
variable     scale equal 4.83166430676946e-16/1.3806504e-23/70/70/$V*$s*${dt}
variable     scale equal 4.83166430676946e-16/1.3806504e-23/70/70/9943.923032064*$s*${dt}
variable     scale equal 4.83166430676946e-16/1.3806504e-23/70/70/9943.923032064*10*${dt}
variable     scale equal 4.83166430676946e-16/1.3806504e-23/70/70/9943.923032064*10*4
variable     k11 equal trap(f_JJ[3])*${scale}
variable     k11 equal trap(f_JJ[3])*28.7289125255705
variable     k22 equal trap(f_JJ[4])*${scale}
variable     k22 equal trap(f_JJ[4])*28.7289125255705
variable     k33 equal trap(f_JJ[5])*${scale}
variable     k33 equal trap(f_JJ[5])*28.7289125255705
variable soapff_pxy equal pxy
variable soapff_pxz equal pxz
variable soapff_pyz equal pyz
fix          SS all ave/correlate $s $p $d v_soapff_pxy v_soapff_pxz v_soapff_pyz type auto file gk_viscosity.dat ave running
fix          SS all ave/correlate 10 $p $d v_soapff_pxy v_soapff_pxz v_soapff_pyz type auto file gk_viscosity.dat ave running
fix          SS all ave/correlate 10 200 $d v_soapff_pxy v_soapff_pxz v_soapff_pyz type auto file gk_viscosity.dat ave running
fix          SS all ave/correlate 10 200 2000 v_soapff_pxy v_soapff_pxz v_soapff_pyz type auto file gk_viscosity.dat ave running
variable     scalev equal ${convertv}/(${kB}*$T)*$V*$s*${dt}
variable     scalev equal 1.0266755625e-35/(${kB}*$T)*$V*$s*${dt}
variable     scalev equal 1.0266755625e-35/(1.3806504e-23*$T)*$V*$s*${dt}
variable     scalev equal 1.0266755625e-35/(1.3806504e-23*70)*$V*$s*${dt}
variable     scalev equal 1.0266755625e-35/(1.3806504e-23*70)*9943.923032064*$s*${dt}
variable     scalev equal 1.0266755625e-35/(1.3806504e-23*70)*9943.923032064*10*${dt}
variable     scalev equal 1.0266755625e-35/(1.3806504e-23*70)*9943.923032064*10*4
variable     v11 equal trap(f_SS[3])*${scalev}
variable     v11 equal trap(f_SS[3])*4.22541341898448e-09
variable     v22 equal trap(f_SS[4])*${scalev}
variable     v22 equal trap(f_SS[4])*4.22541341898448e-09
variable     v33 equal trap(f_SS[5])*${scalev}
variable     v33 equal trap(f_SS[5])*4.22541341898448e-09
variable soapff_vol equal vol
fix soapff_state all ave/time 10 10 100 c_thermo_temp c_thermo_press v_soapff_vol c_thermo_pe file soapff_state.dat
thermo_style custom step temp press v_k11 v_k22 v_k33 v_v11 v_v22 v_v33
