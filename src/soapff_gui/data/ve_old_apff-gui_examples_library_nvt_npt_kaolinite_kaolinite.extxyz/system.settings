# soapff-cui settings: ClayFF (Cygan et al. 2004, Tables 1 and 2) with flexible SPC (ClayFF) water; types in system.data from SOAP, charges: clayff2004
units real
atom_style full
boundary p p p
bond_style harmonic
angle_style harmonic
pair_style lj/cut/coul/long 10.0
pair_modify mix arithmetic tail no
special_bonds lj/coul 0.0 0.0 0.0
read_data system.data
pair_coeff 1 1 1.3298e-06 4.27124  # ao
pair_coeff 2 2 0 0  # ho
pair_coeff 3 3 0.1554 3.16554  # ob
pair_coeff 4 4 0.1554 3.16554  # oh
pair_coeff 5 5 1.8405e-06 3.30203  # st
bond_coeff 1 554.1349 1.0  # O-H
angle_coeff 1 30.0 109.47  # MOH-Al-bulk
kspace_style pppm 1.0e-5
